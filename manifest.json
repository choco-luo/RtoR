{
  "manifest_version": 3,
  "name": "Xiaohongshu to Rednote Redirect",
  "version": "1.0.0",
  "description": "Redirect www.xiaohongshu.com to www.rednote.com.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://www.xiaohongshu.com/*"
  ],
  "icons": {
    "16": "icons/x16.png",
    "32": "icons/x32.png",
    "48": "icons/x48.png",
    "128": "icons/x128.png"
  },
  "action": {
    "default_title": "Rednote Redirect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/x16.png",
      "32": "icons/x32.png",
      "48": "icons/x48.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}
